FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap ripgrep ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --upgrade pip && pip install .

USER 65532:65532
EXPOSE 8080
CMD ["uvicorn", "lode.command_runner.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
