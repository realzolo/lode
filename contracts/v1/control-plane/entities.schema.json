{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lode.local/contracts/v1/control-plane/entities.schema.json",
  "title": "Lode V1 Control Plane Entities",
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "ingestion_topic", "model_policy_revision_id", "architecture_context_revision_id", "ingestion_state", "ingestion_version", "ingestion_start_position"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "maxLength": 1000},
        "ingestion_topic": {"type": "string", "minLength": 1},
        "model_policy_revision_id": {"type": ["integer", "null"], "minimum": 1, "maximum": 4503599627370495},
        "architecture_context_revision_id": {"type": ["integer", "null"], "minimum": 1, "maximum": 4503599627370495},
        "ingestion_state": {"type": "string", "enum": ["draft", "active", "paused"]},
        "ingestion_version": {"type": "integer", "minimum": 0},
        "ingestion_start_position": {"type": ["string", "null"], "enum": ["earliest", "latest", null]}
      }
    },
    "workspaceArchitectureContextRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "entries", "revision"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "workspace_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "entries": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "title", "content"],
            "properties": {
              "kind": {"type": "string", "enum": ["system_purpose", "architecture", "critical_flow", "dependency", "operational_convention"]},
              "title": {"type": "string", "minLength": 1, "maxLength": 120},
              "content": {"type": "string", "minLength": 1, "maxLength": 4000}
            }
          }
        },
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "workspaceReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "can_start", "checks", "runtime"],
      "properties": {
        "workspace_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "can_start": {"type": "boolean"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "outcome", "details"],
            "properties": {
              "code": {"type": "string", "enum": ["kafka_topic", "model_policy", "repositories", "evidence_connectors", "architecture_context"]},
              "outcome": {"type": "string", "enum": ["passed", "blocked", "warning"]},
              "details": {"type": "object"}
            }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["observed_state", "observed_version", "consumer_id", "assigned_partitions", "backlog", "last_heartbeat_at", "last_error"],
          "properties": {
            "observed_state": {"type": "string", "enum": ["idle", "starting", "listening", "paused", "error"]},
            "observed_version": {"type": "integer", "minimum": 0},
            "consumer_id": {"type": ["string", "null"]},
            "assigned_partitions": {"type": "integer", "minimum": 0},
            "backlog": {"type": ["integer", "null"], "minimum": 0},
            "last_heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
            "last_error": {"type": ["string", "null"]}
          }
        }
      }
    },
    "repositoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "repository_id", "account_connection_id", "account_name", "external_account_login", "provider_kind", "name", "full_name", "repo_url", "web_url", "repo_type", "default_branch", "branch_mode", "branch_name", "effective_branch", "analysis_mode", "is_alert_source", "priority", "description", "state", "revision"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "workspace_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "repository_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "account_connection_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "account_name": {"type": "string", "minLength": 1},
        "external_account_login": {"type": "string", "minLength": 1},
        "provider_kind": {"type": "string", "enum": ["github", "gitlab", "gitee"]},
        "name": {"type": "string", "minLength": 1},
        "full_name": {"type": "string", "minLength": 1},
        "repo_url": {"type": "string", "minLength": 1},
        "web_url": {"type": "string", "minLength": 1},
        "repo_type": {"type": "string"},
        "default_branch": {"type": "string", "minLength": 1},
        "branch_mode": {"type": "string", "enum": ["default", "branch"]},
        "branch_name": {"type": ["string", "null"]},
        "effective_branch": {"type": "string", "minLength": 1},
        "analysis_mode": {"type": "string", "enum": ["code", "documentation"]},
        "is_alert_source": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0},
        "description": {"type": "string", "maxLength": 2000},
        "state": {"type": "string", "enum": ["active", "disabled"]},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "repositoryAnalysisJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "requested_binding_ids", "state", "attempt", "source_revisions", "graph_revision_id", "scanned_file_count", "issue_count", "failure_code"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "workspace_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "requested_binding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4503599627370495}},
        "state": {"type": "string", "enum": ["queued", "running", "succeeded", "failed"]},
        "attempt": {"type": "integer", "minimum": 0},
        "source_revisions": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
        "graph_revision_id": {"type": ["integer", "null"], "minimum": 1, "maximum": 4503599627370495},
        "scanned_file_count": {"type": "integer", "minimum": 0},
        "issue_count": {"type": "integer", "minimum": 0},
        "failure_code": {"type": ["string", "null"]}
      }
    },
    "platformSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_output_language", "revision"],
      "properties": {
        "ai_output_language": {"type": "string", "enum": ["en", "zh"]},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "aiProviderAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "provider_kind", "protocol_id", "base_url", "state", "verification_status", "revision"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "name": {"type": "string", "minLength": 1},
        "provider_kind": {"type": "string", "enum": ["openai", "anthropic"]},
        "protocol_id": {"type": "string", "enum": ["openai.responses.v1", "openai.chat_completions.v1", "anthropic.messages.v1"]},
        "base_url": {"type": "string", "minLength": 1},
        "state": {"type": "string", "enum": ["active", "disabled"]},
        "verification_status": {"type": "string", "enum": ["untested", "healthy", "unavailable"]},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "providerAccountModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider_account_id", "provider_model_id", "display_name", "capabilities", "discovery_state", "availability_state", "state", "revision"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "provider_account_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "provider_model_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "capabilities": {"type": "object"},
        "discovery_state": {"type": "string", "enum": ["discovered", "manual", "missing"]},
        "availability_state": {"type": "string", "enum": ["untested", "healthy", "unavailable"]},
        "state": {"type": "string", "enum": ["active", "disabled"]},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "workspaceModelBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "provider_account_model_id", "execution_classes", "allowed_roles", "priority", "max_calls", "max_cost_per_call", "timeout_ms", "allowed_data_classes", "max_context_utilization", "state", "revision"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "workspace_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "provider_account_model_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "execution_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["latency_optimized", "reasoning_optimized"]}},
        "allowed_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["resource_analyst", "planner", "native_query", "synthesizer", "verifier", "context_compactor"]}},
        "priority": {"type": "integer", "minimum": 0},
        "max_calls": {"type": "integer", "minimum": 1},
        "max_cost_per_call": {"type": "number", "minimum": 0},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "allowed_data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["masked", "source_code", "internal", "restricted"]}},
        "max_context_utilization": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "state": {"type": "string", "enum": ["active", "disabled"]},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "modelPolicyRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspace_id", "eligible_bindings", "role_policies", "context_policy_revision_id", "revision"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "workspace_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "eligible_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binding_id", "revision"],
            "properties": {
              "binding_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
              "revision": {"type": "integer", "minimum": 1}
            }
          }
        },
        "role_policies": {"type": "object"},
        "context_policy_revision_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "contextBundleRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "investigation_id", "role", "routing_decision_id", "state_packet", "evidence_refs", "summary_refs", "tokenizer_id", "token_count", "reserved_output_tokens", "context_hash", "revision"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "investigation_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "role": {"type": "string", "enum": ["resource_analyst", "planner", "native_query", "synthesizer", "verifier", "context_compactor"]},
        "routing_decision_id": {"type": "integer", "minimum": 1, "maximum": 4503599627370495},
        "state_packet": {"type": "object"},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 4503599627370495}},
        "summary_refs": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 4503599627370495}},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "token_count": {"type": "integer", "minimum": 0},
        "reserved_output_tokens": {"type": "integer", "minimum": 1},
        "context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    }
  }
}
