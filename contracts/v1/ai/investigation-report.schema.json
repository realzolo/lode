{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lode.local/contracts/v1/ai/investigation-report.schema.json",
  "title": "investigation-report.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_state",
    "headline",
    "summary",
    "incident_cause",
    "code_diagnosis",
    "code_findings",
    "participants",
    "timeline_summary",
    "source_assessments",
    "configuration_assessments",
    "confirmed_facts",
    "counter_evidence",
    "evidence_gaps",
    "next_step"
  ],
  "properties": {
    "result_state": {"type": "string", "enum": ["confirmed", "hypothesis", "insufficient", "unavailable"]},
    "headline": {"type": "string"},
    "summary": {"type": "string"},
    "incident_cause": {"$ref": "#/$defs/cause"},
    "code_diagnosis": {"$ref": "#/$defs/codeDiagnosis"},
    "code_findings": {"type": "array", "items": {"$ref": "#/$defs/codeFinding"}},
    "participants": {"type": "array", "items": {"$ref": "#/$defs/participant"}},
    "timeline_summary": {"type": "array", "items": {"$ref": "#/$defs/timelineItem"}},
    "source_assessments": {"type": "array", "items": {"$ref": "#/$defs/sourceAssessment"}},
    "configuration_assessments": {"type": "array", "items": {"$ref": "#/$defs/configAssessment"}},
    "confirmed_facts": {"type": "array", "items": {"$ref": "#/$defs/evidenceStatement"}},
    "counter_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceStatement"}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "next_step": {"type": "string"}
  },
  "$defs": {
    "cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mechanism", "causal_chain", "evidence_refs"],
      "properties": {
        "status": {"type": "string", "enum": ["confirmed", "hypothesis", "not_found"]},
        "mechanism": {"type": "string"},
        "causal_chain": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "codeDiagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "finding_indices"],
      "properties": {
        "status": {"type": "string", "enum": ["confirmed", "hypothesis", "no_defect", "not_found"]},
        "summary": {"type": "string"},
        "finding_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "codeFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "source_artifact_id", "source_assessment_id", "repository_id",
        "revision", "revision_origin", "path", "symbol", "start_line", "end_line",
        "issue_type", "faulty_behavior", "why_wrong", "expected_behavior",
        "trigger_condition", "propagation", "incident_evidence_refs",
        "supporting_evidence_refs", "counter_evidence_refs", "missing_validation",
        "test_scenario"
      ],
      "properties": {
        "status": {"type": "string", "enum": ["confirmed", "hypothesis", "no_defect", "not_found"]},
        "source_artifact_id": {"type": ["integer", "null"], "minimum": 1},
        "source_assessment_id": {"type": ["integer", "null"], "minimum": 1},
        "repository_id": {"type": ["integer", "null"], "minimum": 1},
        "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "revision_origin": {"type": ["string", "null"], "enum": ["alert_revision", "bound_branch_head", "runtime_observed", null]},
        "path": {"type": ["string", "null"]},
        "symbol": {"type": ["string", "null"]},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "issue_type": {"type": ["string", "null"]},
        "faulty_behavior": {"type": "string"},
        "why_wrong": {"type": "string"},
        "expected_behavior": {"type": "string"},
        "trigger_condition": {"type": "string"},
        "propagation": {"type": "array", "items": {"type": "string"}},
        "incident_evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "supporting_evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "counter_evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "missing_validation": {"type": "array", "items": {"type": "string"}},
        "test_scenario": {"type": "string"}
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_ref", "display_name", "identity_status", "evidence_refs"],
      "properties": {
        "entity_ref": {"type": "integer", "minimum": 1},
        "display_name": {"type": "string"},
        "identity_status": {"type": "string", "enum": ["verified", "provisional", "ambiguous", "unknown"]},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurred_at", "event_ref", "summary", "evidence_refs"],
      "properties": {
        "occurred_at": {"type": "string", "format": "date-time"},
        "event_ref": {"type": "integer", "minimum": 1},
        "summary": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "sourceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "build_unit_id", "component_id", "revision", "revision_origin", "authority_status", "compatibility_status", "mismatch_reasons", "evidence_refs"],
      "properties": {
        "repository_id": {"type": "integer", "minimum": 1},
        "build_unit_id": {"type": ["integer", "null"], "minimum": 1},
        "component_id": {"type": ["integer", "null"], "minimum": 1},
        "revision": {"type": ["string", "null"]},
        "revision_origin": {"type": "string", "enum": ["alert_revision", "bound_branch_head", "runtime_observed"]},
        "authority_status": {"type": "string", "enum": ["authoritative", "corroborated", "contradicted", "unavailable"]},
        "compatibility_status": {"type": "string", "enum": ["not_checked", "compatible", "incompatible"]},
        "mismatch_reasons": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "configAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "declared_value_json", "runtime_value_json", "effective_status", "evidence_refs"],
      "properties": {
        "scope": {"type": "string"},
        "declared_value_json": {"type": "string", "maxLength": 262144},
        "runtime_value_json": {"type": "string", "maxLength": 262144},
        "effective_status": {"type": "string", "enum": ["unknown", "corroborated", "contradicted"]},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "evidenceStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_refs"],
      "properties": {
        "text": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    }
  }
}
