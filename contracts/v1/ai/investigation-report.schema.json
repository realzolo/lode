{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lode.local/contracts/v1/ai/investigation-report.schema.json",
  "title": "investigation-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_state",
    "headline",
    "executive_summary",
    "impact_scope",
    "causal_graph",
    "code_findings",
    "participants",
    "timeline_summary",
    "source_assessments",
    "configuration_assessments",
    "counter_evidence",
    "evidence_gaps",
    "action_recommendations"
  ],
  "properties": {
    "result_state": {"type": "string", "enum": ["confirmed", "hypothesis", "insufficient", "unavailable"]},
    "headline": {"type": "string"},
    "executive_summary": {"type": "string"},
    "impact_scope": {"type": "array", "items": {"$ref": "#/$defs/evidenceStatement"}},
    "causal_graph": {"$ref": "#/$defs/causalGraph"},
    "code_findings": {"type": "array", "items": {"$ref": "#/$defs/codeFinding"}},
    "participants": {"type": "array", "items": {"$ref": "#/$defs/participant"}},
    "timeline_summary": {"type": "array", "items": {"$ref": "#/$defs/timelineItem"}},
    "source_assessments": {"type": "array", "items": {"$ref": "#/$defs/sourceAssessment"}},
    "configuration_assessments": {"type": "array", "items": {"$ref": "#/$defs/configAssessment"}},
    "counter_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidenceStatement"}},
    "evidence_gaps": {"type": "array", "items": {"$ref": "#/$defs/evidenceGap"}},
    "action_recommendations": {"type": "array", "items": {"$ref": "#/$defs/actionRecommendation"}}
  },
  "$defs": {
    "causalNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node_type", "status", "statement", "evidence_refs", "entity_refs"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "node_type": {"type": "string", "enum": ["impact", "trigger", "root_cause", "contributing_factor", "propagation", "detection", "mitigation", "recovery", "counter_evidence", "evidence_gap"]},
        "status": {"type": "string", "enum": ["confirmed", "hypothesis", "refuted", "unknown"]},
        "statement": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "entity_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "causalEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "source_node_id", "target_node_id", "status", "relation", "statement", "evidence_refs"],
      "properties": {
        "edge_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "source_node_id": {"type": "string"},
        "target_node_id": {"type": "string"},
        "status": {"type": "string", "enum": ["confirmed", "hypothesis", "refuted"]},
        "relation": {"type": "string", "enum": ["triggers", "causes", "contributes_to", "propagates_to", "detected_by", "mitigated_by", "recovers", "contradicts"]},
        "statement": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "causalGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges", "root_node_ids"],
      "properties": {
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/causalNode"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/causalEdge"}},
        "root_node_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "codeFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_artifact_id", "source_assessment_id", "repository_id", "revision", "revision_origin", "path", "symbol", "start_line", "end_line", "issue_type", "faulty_behavior", "why_wrong", "expected_behavior", "trigger_condition", "propagation", "incident_evidence_refs", "supporting_evidence_refs", "counter_evidence_refs", "missing_validation", "test_scenario"],
      "properties": {
        "status": {"type": "string", "enum": ["confirmed", "hypothesis", "no_defect", "not_found"]},
        "source_artifact_id": {"type": ["integer", "null"], "minimum": 1},
        "source_assessment_id": {"type": ["integer", "null"], "minimum": 1},
        "repository_id": {"type": ["integer", "null"], "minimum": 1},
        "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "revision_origin": {"type": ["string", "null"], "enum": ["alert_revision", "bound_branch_head", "runtime_observed", null]},
        "path": {"type": ["string", "null"]},
        "symbol": {"type": ["string", "null"]},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "issue_type": {"type": ["string", "null"]},
        "faulty_behavior": {"type": "string"},
        "why_wrong": {"type": "string"},
        "expected_behavior": {"type": "string"},
        "trigger_condition": {"type": "string"},
        "propagation": {"type": "array", "items": {"type": "string"}},
        "incident_evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "supporting_evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "counter_evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "missing_validation": {"type": "array", "items": {"type": "string"}},
        "test_scenario": {"type": "string"}
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_ref", "display_name", "identity_status", "evidence_refs"],
      "properties": {
        "entity_ref": {"type": "integer", "minimum": 1},
        "display_name": {"type": "string"},
        "identity_status": {"type": "string", "enum": ["verified", "provisional", "ambiguous", "unknown"]},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurred_at", "event_ref", "summary", "evidence_refs"],
      "properties": {
        "occurred_at": {"type": "string", "format": "date-time"},
        "event_ref": {"type": "integer", "minimum": 1},
        "summary": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "sourceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "build_unit_id", "component_id", "revision", "revision_origin", "authority_status", "compatibility_status", "mismatch_reasons", "evidence_refs"],
      "properties": {
        "repository_id": {"type": "integer", "minimum": 1},
        "build_unit_id": {"type": ["integer", "null"], "minimum": 1},
        "component_id": {"type": ["integer", "null"], "minimum": 1},
        "revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "revision_origin": {"type": "string", "enum": ["alert_revision", "bound_branch_head", "runtime_observed"]},
        "authority_status": {"type": "string", "enum": ["authoritative", "corroborated", "contradicted", "unavailable"]},
        "compatibility_status": {"type": "string", "enum": ["not_checked", "compatible", "incompatible"]},
        "mismatch_reasons": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "configAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "declared_value_json", "runtime_value_json", "effective_status", "evidence_refs"],
      "properties": {
        "scope": {"type": "string"},
        "declared_value_json": {"type": "string", "maxLength": 262144},
        "runtime_value_json": {"type": "string", "maxLength": 262144},
        "effective_status": {"type": "string", "enum": ["unknown", "corroborated", "contradicted"]},
        "evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "evidenceStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_refs"],
      "properties": {
        "text": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "evidenceGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "consequence", "required_evidence", "related_node_ids"],
      "properties": {
        "description": {"type": "string"},
        "consequence": {"type": "string"},
        "required_evidence": {"type": "string"},
        "related_node_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "actionRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "priority", "title", "rationale", "validation", "evidence_refs"],
      "properties": {
        "action_type": {"type": "string", "enum": ["mitigate", "remediate", "validate", "prevent"]},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
        "title": {"type": "string"},
        "rationale": {"type": "string"},
        "validation": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    }
  }
}
