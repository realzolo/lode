{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lode.local/contracts/v1/ai/investigation-decision.schema.json",
  "title": "investigation-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "hypotheses", "operations", "objective", "next_model_hint"],
  "properties": {
    "decision": {"type": "string", "enum": ["continue", "finish"]},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/hypothesis"}
    },
    "operations": {
      "type": "array",
      "maxItems": 4,
      "items": {"$ref": "#/$defs/operation"}
    },
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "next_model_hint": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/modelHint"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "finish"}}},
      "then": {"properties": {"operations": {"maxItems": 0}}},
      "else": {"properties": {"operations": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis_id", "mechanism", "supporting_evidence_refs", "counter_evidence_refs", "evidence_gaps", "confirmation_requested", "counter_evidence_unavailable"],
      "properties": {
        "hypothesis_id": {"type": "string", "pattern": "^h[1-9][0-9]{0,5}$"},
        "mechanism": {"type": "string", "minLength": 1, "maxLength": 2000},
        "supporting_evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "counter_evidence_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "evidence_gaps": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "confirmation_requested": {"type": "boolean"},
        "counter_evidence_unavailable": {"type": "boolean"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "purpose",
        "expected_evidence",
        "evidence_anchors",
        "supports_hypotheses",
        "refutes_hypotheses",
        "selection_reason",
        "estimated_cost",
        "stop_condition",
        "depends_on",
        "source_query"
      ],
      "properties": {
        "action_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{0,199}$"},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
        "expected_evidence": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_anchors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "supports_hypotheses": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "refutes_hypotheses": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "selection_reason": {"type": "string", "minLength": 1, "maxLength": 2000},
        "estimated_cost": {"type": "number", "minimum": 0},
        "stop_condition": {"type": "string", "minLength": 1, "maxLength": 2000},
        "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_query": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sourceQuery"}
          ]
        }
      }
    },
    "sourceQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "symbols", "path_hints", "evidence_refs"],
      "properties": {
        "terms": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "symbols": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "path_hints": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "modelHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "execution_class", "required_context_tokens", "reason"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["resource_analyst", "planner", "native_query", "synthesizer", "verifier", "context_compactor"]
        },
        "execution_class": {"type": "string", "enum": ["latency_optimized", "reasoning_optimized"]},
        "required_context_tokens": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
