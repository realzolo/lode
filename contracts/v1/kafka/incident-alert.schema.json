{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lode.local/contracts/v1/kafka/incident-alert.schema.json",
  "title": "incident.alert.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "alert_id",
    "occurred_at",
    "severity",
    "event",
    "trace_id",
    "source_revision",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "incident.alert.v1"},
    "alert_id": {"type": "string", "minLength": 1, "maxLength": 500},
    "occurred_at": {"type": "string", "format": "date-time"},
    "severity": {"type": "string", "enum": ["CRITICAL", "WARNING"]},
    "event": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "trace_id": {"type": "string"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "error": {"$ref": "#/$defs/error"}
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message", "stack", "cause"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 500},
        "message": {"type": "string", "maxLength": 20000},
        "stack": {"type": "string", "maxLength": 50000},
        "cause": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/error"}
          ]
        }
      }
    }
  }
}
