# Incident Trace — environment configuration
# All variables are read with the IT_ prefix by src/incident_trace/config.py

# PostgreSQL connection used by the server, the migration tool and the consumer.
# Async driver (asyncpg) is required.
IT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_trace

# Kafka bootstrap servers (comma separated)
IT_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Consumer group id
IT_KAFKA_GROUP_ID=incident-trace-consumer

# Topic subscription pattern (default: every product/topic)
IT_KAFKA_TOPIC_PATTERN=alert\..*

# Dead-letter topic for rejected/invalid messages
IT_KAFKA_DLQ_TOPIC=incident_trace.dlq

# Unassigned topic: messages whose topic does not map to any application
IT_KAFKA_UNASSIGNED_TOPIC=incident_trace.unassigned

# HTTP listen settings
IT_HTTP_HOST=0.0.0.0
IT_HTTP_PORT=8000

# Security / auth — set a strong secret in production.
IT_SECRET_KEY=change-me-in-production
IT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
IT_JWT_TTL_SECONDS=86400
