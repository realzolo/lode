# Lode — environment configuration
# All variables are read with the LODE_ prefix by src/lode/config.py

# PostgreSQL connection used by the server, the migration tool and the consumer.
# Async driver (asyncpg) is required.
LODE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lode

# Kafka bootstrap servers (comma separated)
LODE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka SASL/PLAIN auth — leave username empty for unauthenticated local dev.
# Set security.protocol=SASL_PLAINTEXT and supply the PLAIN credentials for a
# secured broker.
LODE_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
LODE_KAFKA_SASL_MECHANISM=PLAIN
LODE_KAFKA_SASL_USERNAME=
LODE_KAFKA_SASL_PASSWORD=

# Consumer group id
LODE_KAFKA_GROUP_ID=lode-consumer

# Active Workspace topics are the consumer subscription source of truth.
LODE_KAFKA_SUBSCRIPTION_REFRESH_SECONDS=5
LODE_KAFKA_RUNTIME_STALE_SECONDS=20
LODE_KAFKA_TOPIC_VALIDATION_TIMEOUT_SECONDS=10
LODE_KAFKA_BATCH_MAX_RECORDS=100

# Dead-letter topic for rejected/invalid messages
LODE_KAFKA_DLQ_TOPIC=lode.dlq

# Unassigned topic: messages whose topic does not map to any Workspace
LODE_KAFKA_UNASSIGNED_TOPIC=lode.unassigned

# HTTP listen settings
LODE_HTTP_HOST=0.0.0.0
LODE_HTTP_PORT=8000
LODE_RATE_LIMIT_ENABLED=true
LODE_RATE_LIMIT_PER_MINUTE=600

# Durable investigation and recovery bounds.
LODE_ENGINE_CONCURRENCY=5
LODE_INVESTIGATION_MAX_EVIDENCE_STEPS=12
LODE_INVESTIGATION_MAX_MODEL_CALLS=10
LODE_INVESTIGATION_MAX_NATIVE_READS=8
LODE_INVESTIGATION_MAX_OUTPUT_BYTES=8388608
LODE_INVESTIGATION_MAX_COST=100
LODE_INVESTIGATION_TIMEOUT_SECONDS=600
LODE_WORKER_LEASE_TTL_SECONDS=300
LODE_WORKER_POLL_INTERVAL_SECONDS=1
LODE_JOB_MAX_ATTEMPTS=5
LODE_JOB_BASE_RETRY_DELAY=5

# AI calls: health probes stay short; evidence-rich synthesis gets a longer
# per-attempt timeout and bounded structured output. Transient failures retry
# with exponential backoff.
LODE_LLM_MAX_RETRIES=3
LODE_LLM_RETRY_BASE_DELAY=0.5
LODE_LLM_REQUEST_TIMEOUT_SECONDS=120
LODE_LLM_PROBE_TIMEOUT_SECONDS=30
LODE_LLM_MAX_OUTPUT_TOKENS=8192
# AI provider calls are disabled until both the DNS host and every resolved IP
# range are explicitly authorized. Example public CIDRs are deployment-specific.
LODE_AI_PROVIDER_EGRESS_ALLOWLIST=
LODE_AI_PROVIDER_ALLOWED_IP_CIDRS=
LODE_AI_PROVIDER_MAX_RESPONSE_BYTES=2097152
# Remote Git is also fail-closed. Local absolute/file repositories do not use egress.
LODE_GIT_EGRESS_ALLOWLIST=
LODE_GIT_ALLOWED_IP_CIDRS=

# Base directory for one temporary, isolated Git source sandbox per analysis.
# Sandboxes are deleted after masked evidence excerpts are persisted.
LODE_EVIDENCE_GIT_CACHE_DIR=/tmp/lode/git

# Security/auth keys must be independent and contain at least 32 bytes.
LODE_SECRET_KEY=replace-with-a-random-secret-at-least-32-bytes
# Independent key used to encrypt credentials stored by the control plane.
LODE_DATA_ENCRYPTION_KEY=replace-with-a-different-random-secret
# Independent HMAC key for short-lived native evidence-read capabilities.
LODE_EVIDENCE_AUTHORIZATION_KEY=replace-with-a-third-random-secret
# Shared only by the worker and isolated command-runner process (minimum 32 bytes).
LODE_COMMAND_RUNNER_URL=http://command-runner:8080
LODE_COMMAND_RUNNER_KEY=replace-with-a-fourth-random-secret-at-least-32-bytes
LODE_COMMAND_RUNNER_ENABLED=true
# Hierarchical evidence-access kill switches. IDs are comma-separated positive integers;
# languages are logql, elasticsearch_query_dsl, opensearch_query_dsl, sql, https, command.
LODE_EVIDENCE_ACCESS_ENABLED=true
LODE_EVIDENCE_DISABLED_WORKSPACE_IDS=
LODE_EVIDENCE_DISABLED_CONNECTOR_IDS=
LODE_EVIDENCE_DISABLED_LANGUAGES=
# Optional trusted executable paths; arguments are fixed and shell execution is disabled.
LODE_LOGQL_PARSER_NODE=node
LODE_LOGQL_PARSER_SCRIPT=
LODE_LOGQL_PARSER_TIMEOUT_SECONDS=2
# Comma-separated exact DNS names or wildcard suffixes (for example *.corp.example).
LODE_INTEGRATION_EGRESS_ALLOWLIST=
LODE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LODE_JWT_TTL_SECONDS=86400
