# Lode — environment configuration
# All variables are read with the LODE_ prefix by src/lode/config.py

# PostgreSQL connection used by the server, the migration tool and the consumer.
# Async driver (asyncpg) is required.
LODE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lode

# Kafka bootstrap servers (comma separated)
LODE_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka SASL/PLAIN auth — leave username empty for unauthenticated local dev.
# Set security.protocol=SASL_PLAINTEXT and supply the PLAIN credentials for a
# secured broker.
LODE_KAFKA_SECURITY_PROTOCOL=PLAINTEXT
LODE_KAFKA_SASL_MECHANISM=PLAIN
LODE_KAFKA_SASL_USERNAME=
LODE_KAFKA_SASL_PASSWORD=

# Consumer group id
LODE_KAFKA_GROUP_ID=lode-consumer

# Active application bindings are the consumer subscription source of truth.
LODE_KAFKA_SUBSCRIPTION_REFRESH_SECONDS=5
LODE_KAFKA_RUNTIME_STALE_SECONDS=20
LODE_KAFKA_TOPIC_VALIDATION_TIMEOUT_SECONDS=10

# Dead-letter topic for rejected/invalid messages
LODE_KAFKA_DLQ_TOPIC=lode.dlq

# Unassigned topic: messages whose topic does not map to any application
LODE_KAFKA_UNASSIGNED_TOPIC=lode.unassigned

# HTTP listen settings
LODE_HTTP_HOST=0.0.0.0
LODE_HTTP_PORT=8000

# Base directory for one temporary, isolated Git source sandbox per analysis.
# Sandboxes are deleted after masked evidence excerpts are persisted.
LODE_EVIDENCE_GIT_CACHE_DIR=/tmp/lode/git

# Security / auth — set a strong secret in production.
LODE_SECRET_KEY=change-me-in-production
LODE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LODE_JWT_TTL_SECONDS=86400
